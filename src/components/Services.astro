    </section>

<section class="relative min-h-screen flex flex-col lg:flex-row items-stretch border-b border-gray-200">
    <div class="w-full lg:w-1/2 p-8 md:p-16 lg:p-24 flex flex-col justify-center sticky top-0 bg-gray-200">
      <div class="max-w-xl">
        <div class="flex items-center gap-4 mb-6">
          <span class="text-5xl font-light text-emerald-600/50 font-mono">01</span>
          <div class="h-[1px] w-12 bg-emerald-500/50"></div>
          <span class="text-xs uppercase tracking-widest text-emerald-700 font-bold">{t.services.subtitleFiscal}</span>
        </div>
        
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6 tracking-tight">{t.services.titleFirstCard}</h2>
        
        <p class="text-gray-600 mb-6 leading-relaxed text-lg">
            {t.services.descriptionCardFiscal}
        </p>
        
        <ul class="space-y-3 text-sm text-gray-600 border-l-2 border-emerald-500/40 pl-4 mb-8">
            {itemsFirst.map((item)=>(
                <li class="flex items-center text-sm font-medium text-gray-800">
                    {/* El contenedor del check ahora es verde suave con icono verde oscuro */}
                    <span class="w-8 h-8 rounded-lg bg-emerald-50 flex items-center justify-center mr-3 border border-emerald-200">
                        <i class="fa-solid fa-check text-emerald-600"></i>
                    </span>
                    {item.title}
                </li>
            ))}   
        </ul>
        
        </div>
    </div>
    <div class="w-full lg:w-1/2 relative bg-gray-200 min-h-[400px] lg:min-h-0 overflow-hidden">
        <img src="https://dimdestruccion.com/wp-content/uploads/2022/07/destruccionmercancias.jpeg" alt="" class="absolute inset-0 w-full h-full object-cover opacity-90 transition-all hover:scale-105 duration-500">
        <div class="absolute inset-0 bg-gradient-to-t from-gray-200 via-transparent to-transparent lg:bg-gradient-to-r lg:from-gray-200 lg:via-transparent"></div>
        <div class="absolute bottom-8 right-8 bg-gray-200 backdrop-blur border border-gray-200 p-4 rounded-xl shadow-sm text-xs text-gray-600 max-w-xs hidden sm:block">
            <p class="font-bold text-gray-900 mb-1 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Módulo de Control Técnico
            </p>
            Registro en video HD en tiempo real para evidencias deducibles de impuestos.
        </div>
    </div>
</section>

  {/* SECCIÓN 2: DESTRUCCIÓN DE MERMA (DISEÑO INVERTIDO) */}
<section class="relative min-h-screen flex flex-col lg:flex-row-reverse items-stretch border-b border-gray-200">
    {/* Columna Texto */}
    <div class="w-full lg:w-1/2 p-8 md:p-16 lg:p-24 flex flex-col justify-center sticky top-0 bg-gray-200">
      <div class="max-w-xl">
        <div class="flex items-center gap-4 mb-6">
          <span class="text-5xl font-light text-secondary font-mono">02</span>
          <div class="h-[1px] w-12 bg-secondary"></div>
          <span class="text-xs uppercase tracking-widest text-secondary font-bold">{t.services.subtitleMerma}</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6 tracking-tight">{t.services.titleSecondCard}</h2>
        <p class="text-gray-600 mb-6 leading-relaxed text-lg">
            {t.services.descriptionCardMerma}
        </p>
        <ul class="space-y-3 text-sm text-slate-400 border-l-2 border-gray-200 pl-4 mb-8">
            {itemsSecond.map((item)=>(
                        <li class="flex items-center text-sm font-medium text-gray-800">
                            <span class="w-8 h-8 rounded-lg bg-emerald-50 flex items-center justify-center mr-3 border border-emerald-200">
                                <i class="fa-solid fa-check text-secondary"></i>
                            </span>
                            {item.title}
                        </li>
            ))} 
          <!--<li class="flex items-center gap-2">✔ Trituración y compactación de materiales no conformes.</li>
          <li class="flex items-center gap-2">✔ Recolección programada en líneas de producción.</li>
          <li class="flex items-center gap-2">✔ Enfoque de economía circular (revalorización de residuos post-destrucción).</li>-->
        </ul>
      </div>
    </div>
    
    {/* Columna Video / Multimedia */}
    <div class="w-full lg:w-1/2 relative bg-gray-200 min-h-[400px] lg:min-h-0 overflow-hidden">
        <img src="/servicio-destruccion-merma.webp" alt="Destrucción de merma" class="absolute inset-0 w-full h-full object-cover opacity-90 transition-all hover:scale-105 duration-500">
      <div class="absolute inset-0 bg-gradient-to-t from-gray-200 via-transparent to-transparent lg:bg-gradient-to-l lg:from-gray-200 lg:via-transparent"></div>
    </div>
  </section>

  {/* SECCIÓN 3: INVENTARIO OBSOLETO (DISEÑO DE TEXTO FLUIDO E IMPACTO VISUAL) */}
  <section class="relative min-h-screen flex flex-col lg:flex-row items-stretch">
    {/* Columna Texto */}
    <div class="w-full lg:w-1/2 p-8 md:p-16 lg:p-24 flex flex-col justify-center sticky top-0 bg-gray-200">
      <div class="max-w-xl">
        <div class="flex items-center gap-4 mb-6">
          <span class="text-5xl font-light text-primary/80 font-mono">03</span>
          <div class="h-[1px] w-12 bg-primary/80"></div>
          <span class="text-xs uppercase tracking-widest text-primary/80 font-bold">{t.services.subtitleInventario}</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-6 tracking-tight">{t.services.titleThirdCard}</h2>
        <p class="text-gary-600 mb-6 leading-relaxed text-lg">
        {t.services.descriptionCardInventario}
        </p>
        <div class="grid grid-cols-2 gap-4 my-6 text-gray-800 text-xs uppercase tracking-wider font-mono">
          <div class="border border-primary p-3 bg-gray-200">
            <span class="block text-primary font-bold text-lg mb-1">100%</span> {t.services.miniDescriptionCard}
          </div>
          <div class="border border-primary p-3 bg-gray-200">
            <span class="block text-primary font-bold text-lg mb-1">{t.services.minititleCard}</span>{t.services.minidescriptionCardS}
          </div>
        </div>
      </div>
    </div>
    
    {/* Columna Video / Multimedia */}
    <div class="w-full lg:w-1/2 relative bg-slate-900 min-h-[400px] lg:min-h-0 overflow-hidden">
        <img src="/archivo-muerto-servicio.webp" class="absolute inset-0 w-full h-full object-cover opacity-90 transition-all hover:scale-105 duration-500" alt="">
