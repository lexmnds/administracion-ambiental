# Bloquear archivos sensibles
<FilesMatch "^(\.env|\.htaccess|composer\.json|composer\.lock)$">
  Require all denied
</FilesMatch>

# ----------------------------------------------------------------------
# OPTIMIZACIÓN DE CACHÉ - ADMINISTRACIÓN AMBIENTAL
# ----------------------------------------------------------------------

<IfModule mod_expires.c>
  ExpiresActive On

  # Imágenes (Caché por 1 año - Máxima optimización)
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Archivos de video (Caché por 1 mes)
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"

  # CSS y JavaScript (Caché por 1 mes)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  # Fuentes (Caché por 1 año)
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# Habilitar compresión Gzip (Esto reducirá drásticamente el tamaño de los archivos)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>