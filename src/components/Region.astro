---
const { t } = Astro.props;

const regions = [
    { icon: '', title: '', description: '' },
    { icon: '', title: '', description: '' },
    { icon: '', title: '', description: '' },
    { icon: '', title: '', description: '' },
];
---
<div class="py-12 bg-gray-default bg-blend-multiply mb-6">
    <div class="container mx-auto px-6 lg:px-16">
        <div class="flex flex-col md:flex-row items-center gap-10">

            <!--Imagen izquierda -->
            <div class="w-full md:w-1/2">
                <img data-aos="fade-right" src="/regiones.webp" alt="Beneficios" class="w-full h-64 md:h-full object-cover rounded-base">
            </div>

            <!--Contenido derecha -->
            <div class="w-full md:w-1/2 text-primary">
                <h5 class="text-3xl md:text-3xl font-extrabold mb-4">
                    {t.region.title}
                </h5>
                <p class="mb-6 text-base md:text-lg"> { t.region.description}</p>

                <div class="grid grid-cols-2 gap-6 mt-8 pt-8 border-t border-gray-300">
                    <div>
                        <h4 class="text-lg font-bold text-primary">{t.region.center}</h4>
                        <p class="text-base text-gray-600">{t.region.centerDescription}</p>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold text-primary">{t.region.record}</h4>
                        <p class="text-base text-gray-600">{t.region.recordDescription}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>