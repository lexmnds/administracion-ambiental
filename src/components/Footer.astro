---
import { getLangFromUrl, path } from "../utils/i18";
import SectionContainer from "./SectionContainer.astro";
const { t, pageKey}= Astro.props;
const lang = getLangFromUrl(Astro.url);
---
<SectionContainer>
<!--CARD CONTACT -->
    <div class="flex items-center justify-center w-full bg-secondary/50 p-6 border border-default rounded-base shadow-xs mb-3 mx-auto px-4 py-8 sm:py-10 lg:px-8">
        <div class="max-w-3xl text-center">
            <h5 class="text-4xl font-bold text-primary mb-6">
                {t.footer.titleCardCallSection}
            </h5>
            <p class="mb-6 text-base text-dark sm:text-lg">
                {t.footer.textCardCallSection}
            </p>
            <div class="flex flex-col items-center justify-center space-y-4 sm:flex-row sm:space-y-0 sm:space-x-4">
                <a href={path(lang, "contact")} class="w-full sm:w-auto bg-gray-50 text-primary hover:bg-primary hover:text-white focus:ring-4 focus:outline-none focus:ring-neutral-quaternary rounded-base inline-flex items-center justify-center px-4 py-3">
                    <i class="fa-solid fa-phone mr-2"></i>
                    <span class="text-sm font-bold">{t.footer.call}</span>
                </a>
                <a href={path(lang, "contact")} class="w-full sm:w-auto bg-primary text-gray-50 hover:bg-gray-50 hover:text-primary focus:ring-4 focus:outline-none focus:ring-neutral-quaternary rounded-base inline-flex items-center justify-center px-4 py-3">
                    <i class="fa-solid fa-book mr-2"></i>
                    <span class="text-sm font-bold">{t.footer.cotization}</span>
                </a>
            </div>
        </div>
    </div>
</SectionContainer>

<div class="w-full bg-secondary py-6 flex items-center justify-center min-h-[5rem]"> 
    <div class="container mx-auto px-6 text-center sm:text-left flex flex-col sm:flex-row items-center justify-center">   
        <h5 class="text-base md:text-lg font-bold tracking-wider text-white text-center uppercase">
            {t.footer.text}
        </h5>    
    </div>
</div>
    <!--Botoón de WhatsApp -->
    <a  href="https://wa.me/52?text=Hola%2C%20buen%20d%C3%ADa.%20Quiero%20recibir%20m%C3%A1s%20informaci%C3%B3n%20sobre%20los%20servicios%20de%20Administración%20Ambiental.%20%C2%BFPodr%C3%ADan%20brindarme%20apoyo%2C%20por%20favor%3F" target="_blank" class="fixed bottom-6 right-6 bg-green-500 hover:bg-green-600 text-white p-4 rounded-full shadow-lg transition duration-300 z-50 " aria-label="WhatsApp">
        <i class="fab fa-whatsapp text-3xl"></i>
    </a>

<footer class="bg-gray-default">
    <div class="mx-auto w-full max-w-screen-xl p-4 py-6 lg:py-8">
        <div class="flex flex-col gap-8 md:flex-row md:items-start ">
            <!--Logo -->
            <div class="md:flex-shrink-0">
                <a href="/" class="flex flex-col items-center">
                    <img src="/logo-aa.png" class="h-38 me-3" alt=" ADMINISTRACIÓN AMBIENTAL LOGO" />
                    <span class="text-heading text-sm font-medium break-words">
                        {t.footer.slogan}
                    </span>
                    <!-- <span class="text-heading self-center text-2xl font-semibold whitespace-nowrap">Clean Point</span>-->
                </a>
                
            </div>
            <!--Apartado derecho -->
            <div class="grid grid-cols-1 gap-8 sm:grid-cols-3 sm:gap-6 text-left md:ml-auto">
                <div>
                    <h2 class="mb-6 text-sm font-bold text-heading uppercase text-primary">{t.footer.services}</h2>
                    <ul class="text-dark font-medium">
                        <li class="mb-2"><!-- {path(lang, "repse_service")}-->
                            <a href={path(lang, "consultancy_service")} class="hover:text-secondary">{t.footer.firstService}</a>
                            
                        </li>
                        <li class="mb-2"><!--{path(lang, "regulation_service")} -->
                                <a href={path(lang, "support_service")} class="hover:text-secondary">{t.footer.secondService}</a>
                            
                        </li>
                        <li class="mb-2"><!--{path(lang, "insourcing_service")} -->
                                <a href={path(lang, "marketing_service")} class="hover:text-secondary">{t.footer.thirdService}</a>
                        </li>
                        
                    </ul>
                </div>

                <div>
                    <h2 class="mb-6 text-sm font-bold text-heading uppercase text-primary">{t.footer.contact}</h2>
                    <ul class="text-dark font-medium">
                        <li class="mb-4">
                            <i class="fa-solid fa-phone text-primary"></i> <a href="tel: %2055%202624%203210" class="hover:text-secondary"> 55 5555 5555</a>
                        </li>
                        <li class="mb-4">
                            <a href="https://wa.me/52?text=Hola%2C%20buen%20d%C3%ADa.%20Quiero%20recibir%20m%C3%A1s%20informaci%C3%B3n%20sobre%20los%20servicios%20de%20Administración%20Ambiental.%20%C2%BFPodr%C3%ADan%20brindarme%20apoyo%2C%20por%20favor%3F" class="hover:text-secondary"><i class="fa-brands fa-whatsapp text-primary"></i> 55 5555 5555 </a>
                        </li>
                        <li class="mb-4">
                            <i class="fa-regular fa-envelope text-primary break-words"></i> <span class="break-all">correo@empresa.com.mx</span> 
                        </li>
                        <li class="mb-4">
                            <i class="fa-solid fa-location-dot text-primary"></i>
                            <span class="max-w-xs leading-relaxed break-words">
                                {t.footer.direction}
                            </span>
                        </li>
                    </ul>
                </div>
                <div>
                    <h2 class="mb-6 text-sm font-bold text-heading uppercase text-primary">Legal</h2>
                    <ul class="text-dark font-medium">
                        <li class="mb-4"> <!--{path(lang, "privacy")} -->
                            <a href={path(lang, "construction")} class="hover:text-secondary"><i class="fa-regular fa-pen-to-square text-primary hover:text-secondary"></i> {t.footer.legal}</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <hr class="my-6 border-default sm:mx-auto lg:my-8" />

        <div class="text-center">
            <span class="text-sm text-body sm:text-center">
                Copyright © 2026 - Todos los derechos reservados por Administración Ambiental | Por
                <a href="#" aria-label="ARIA LABEL" class="hover:underline text-primary"> A.G</a>
            </span>
        </div>

