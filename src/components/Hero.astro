---
import { path } from "../utils/i18";
const { t } = Astro.props;
const lang = Astro.url.pathname.split("/")[1] || "es";

const videos = {
    es: "",
    en: "",
    ch: ""
}

import {Image} from "astro:assets";
import heroImage from "../assets/hero.webp";

---

<section class="relative pt-24 md:pt-32 overflow-hidden bg-black/50">
    <Image src={heroImage} alt="Fondo Hero" class="absolute inset-0 w-full h-full object-cover mix-blend-multiply" fetchpriority="high" loading="eager" />
        <div class="relative px-4 mx-auto max-w-screen-xl text-left py-8 md:py-16 lg:py-24">
            <h1 class="mb-6 text-4xl font-bold tracking-tighter text-white md:text-5xl lg:text-6xl max-w-3xl">{t.hero.title}</h1>
            <p class="mb-8 text-xl font-normal text-white md:text-xl max-w-2xl">{t.hero.subtitle}</p>
            <div class="flex flex-col space-y-4 sm:flex-row sm:justify-start sm:space-y-0 sm:space-x-4">
                <!-- Modal toggle -->
                <!--<button data-modal-target="default-modal" data-modal-toggle="default-modal" class="text-primary hover:text-secondary-dark bg-gray-default box-border border-transparent hover:bg-gray-soft focus:ring-4 focus:ring-brand-medium shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none" type="button">
                    <i class="fa-solid fa-play"></i>
                        {t.hero.video}
                </button>-->

                <!-- Main modal -->
                <div id="default-modal" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
                    <div class="relative p-4 w-full max-w-6xl max-h-full">
                        <!-- Modal content -->
                        <div class="relative bg-transparent border border-default rounded-base shadow-sm p-4 max-w-5xl md:p-6">
                            <!-- Modal header -->
                            <div class="flex items-center justify-between border-b border-default pb-4 md:pb-5">
                                <button type="button" class="text-primary bg-gray-light hover:bg-neutral-tertiary hover:text-heading rounded-base text-sm w-9 h-9 ms-auto inline-flex justify-center items-center" data-modal-hide="default-modal">
                                    <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 17.94 6M18 18 6.06 6"/></svg>
                                    <span class="sr-only">Close modal</span>
                                </button>
                            </div>
                            <!-- Modal body -->
                            <div class="w-full"> 
                                <video id="video-player" class="w-full aspect-video rounded-base" controls preload="none" playsinline>
                                    <source type="video/mp4" src={videos[lang]} />
                                </video>
                            </div>
                        </div>
                    </div>
                </div>
                <a href={path(lang, "contact")} class="bg-secondary inline-flex items-center justify-center hover:bg-primary box-border border border-transparent focus:ring-4 shadow-xs font-medium rounded-base text-white px-5 py-3 focus:outline-none">
                    <i class="fa-solid fa-file-invoice-dollar"></i> &nbsp;{t.hero.contact}
                </a>
            </div>
        </div>
</section>
<div class="py-8 md:py-12 bg-primary">   
    <div class="container mx-auto px-6 md:px-16 flex flex-col md:flex-row items-center justify-between gap-6">   
        
        <div class="flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-4 max-w-3xl">
            <div class="flex-shrink-0 w-16 h-16 rounded-full bg-white/10 flex items-center justify-center shadow-md text-white text-2xl">
                <i class="fa-solid fa-tree"></i>
            </div>
            
            <div class="flex flex-col">
                <h5 class="mb-2 text-xl font-bold tracking-tight text-white md:text-2xl">
                    {t.hero.titleCard}
                </h5>
                <p class="text-white/90 text-base leading-relaxed">
                    {t.hero.descriptionCard}
                </p>
            </div>
        </div>
        <hr class="w-1 h-18 mx-auto my-4 bg-neutral-quaternary border-0 rounded-sm inline-block align-middle">

        <div class="flex items-center gap-4 p-6 bg-transparent backdrop-blur-sm rounded-2xl border border-transparent aos-init aos-animate">
            <h3 class="text-3xl font-extrabold text-white">{t.hero.miniCardTitle}</h3>
            <p class="text-sm font-semibold opacity-90 text-white">{t.hero.miniCardDescription}</p>
        </div>

    </div>
</div>
