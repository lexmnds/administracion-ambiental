                {t.services.title}
            </h2>
            <p class="text-gray-600 max-w-2xl mx-auto text-lg">
                {t.services.description}
            </p>
            <div class="w-24 h-1 bg-secondary mx-auto mt-6 rounded-full"></div>
        </div>

        

