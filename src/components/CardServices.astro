---
const { t } = Astro.props;
---
<div class="mb-10">
    <h2 class="text-3xl font-bold text-gray-800 inline-block border-b-4 border-secondary items-center text-center mb-6">
        {t.cardServices.title}
    </h2>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
    <div class="bg-white p-8 rounded-[2.5rem] shadow-xl border border-gray-50 flex flex-col h-full">
        <div class="w-14 h-14 bg-secondary/50 text-primary rounded-2xl flex items-center justify-center mb-8">
            <i class="fa-solid fa-dumpster-fire text-2xl"></i>
        </div>
        <h3 class="text-2xl font-extrabold text-primary mb-4 leading-tight">
            {t.cardServices.firstCardTitle}
        </h3>
        <p class="text-gray-500 leading-relaxed">
            {t.cardServices.firstCardDescription}
        </p>
    </div>

    <div class="relative overflow-hidden bg-primary p-8 rounded-[2.5rem] shadow-2xl shadow-green-200 flex flex-col h-full transform md:scale-105 z-10 text-white">
        <div class="absolute -bottom-4 -right-4 text-blue-300 opacity-20 transform -rotate-360">
            <i class="fa-solid fa-file text-9xl"></i>
        </div>                            
        <div class="relative z-10">
            <div class="w-14 h-14 bg-secondary text-primary rounded-2xl flex items-center justify-center mb-8 border border-blue-400/30">
                <i class="fa-solid fa-gavel text-2xl"></i>
            </div>
            <h3 class="text-2xl font-extrabold mb-4 leading-tight">
                {t.cardServices.secondCardTitle}
            </h3>
            <p class="text-blue-100 leading-relaxed">
                {t.cardServices.secondCardDescription}
            </p>
        </div>
    </div>

    <div class="bg-white p-8 rounded-[2.5rem] shadow-xl  border border-gray-50 flex flex-col h-full">
        <div class="w-14 h-14 bg-secondary/50 text-primary rounded-2xl flex items-center justify-center mb-8">
            <i class="fa-solid fa-boxes-stacked text-2xl"></i>
        </div>
        <h3 class="text-2xl font-extrabold text-primary mb-4 leading-tight">
            {t.cardServices.thirdCardTitle}
        </h3>
        <p class="text-gray-500 leading-relaxed">
            {t.cardServices.thirdCardDescription}
        </p>
    </div>
</div>